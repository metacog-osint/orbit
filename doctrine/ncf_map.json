{
  "program": "orbit",
  "version": "2.0",
  "rules": [
    {
      "match": {
        "event_type": "co_orbital_maneuver"
      },
      "ncf": [
        "provide_satellite_access",
        "provide_pnt",
        "provide_defense_materiel"
      ]
    },
    {
      "match": {
        "event_type": "catalog_launch"
      },
      "ncf": [
        "provide_satellite_access"
      ]
    },
    {
      "match": {
        "event_type": "tle_gap"
      },
      "ncf": [
        "provide_satellite_access"
      ]
    },
    {
      "match": {
        "event_type": "scheduled_launch"
      },
      "ncf": [
        "provide_satellite_access"
      ]
    },
    {
      "match": {
        "event_type": "reentry"
      },
      "ncf": [
        "provide_satellite_access"
      ]
    }
  ]
}
